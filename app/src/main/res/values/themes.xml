<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Coffeehouse" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Material 3 Dark Theme for OLED - Pure black background with purple accents -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">false</item>
        
        <!-- Force dark background -->
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">@android:color/black</item>
        
        <!-- Primary and accent colors - purple theme -->
        <item name="colorPrimary">#B388FF</item>
        <item name="colorSecondary">#7C4DFF</item>
        <item name="colorTertiary">#B388FF</item>
        
        <!-- Dark surfaces -->
        <item name="colorSurface">#0a0a0a</item>
        <item name="colorSurfaceVariant">#1a1a1a</item>
        
        <!-- Text and outline colors for dark theme -->
        <item name="colorOnBackground">#FFFFFF</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#B0B0B0</item>
        <item name="colorOutline">#424242</item>
    </style>
</resources>
